# Copiar a .env (no se versiona) y ajustar. Ver conf/app.conf.
GESTION_CONTRACTUAL_CRUD_HTTP_PORT=8080
GESTION_CONTRACTUAL_CRUD_RUN_MODE=dev
# Vacío en local: usa PGUSER/PGPASS. En AWS: lee /<PARAMETER_STORE>/gestion_contractual_crud/db/username|password
PARAMETER_STORE=
GESTION_CONTRACTUAL_CRUD_PGUSER=postgres
GESTION_CONTRACTUAL_CRUD_PGPASS=postgres
GESTION_CONTRACTUAL_CRUD_PGHOST=localhost
GESTION_CONTRACTUAL_CRUD_PGPORT=5435
GESTION_CONTRACTUAL_CRUD_PGDB=administrativa
GESTION_CONTRACTUAL_CRUD_PGSCHEMA=contratacion
